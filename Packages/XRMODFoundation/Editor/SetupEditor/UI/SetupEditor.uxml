<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Style src="SetupEditor.uss" />
    <ui:VisualElement class="root">
        
        <!-- Header Section -->
        <ui:VisualElement class="header-container">
            <ui:Label text="XRMOD Setup" class="header-label" />
            <ui:Button text="Apply" name="ApplyButton" class="apply-button" tooltip="Apply configurations" />
        </ui:VisualElement>
        
        <ui:ScrollView mode="Vertical">
            
            <!-- Environment Settings -->
            <ui:VisualElement class="section-container">
                <ui:Label text="Environment Settings" class="section-title" />
                <uie:EnumField label="Environment" name="EnvironmentType" />
            </ui:VisualElement>

            <!-- SDK Settings -->
            <ui:VisualElement class="section-container">
                <ui:Label text="SDK Settings" class="section-title" />
                <uie:EnumField label="Device" name="DeviceType" />
                
                <ui:VisualElement name="PlatformSettingsContainer" class="platform-settings-container">
                    <!-- Dynamic Content Here -->
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Project Environment Validation -->
            <ui:VisualElement class="section-container" style="flex-grow: 1;">
                <ui:VisualElement class="section-header">
                    <ui:Label text="XRMOD Configuration" name="ProjectEnvironmentTitle" class="section-title" />
                    <ui:Button text="Fix All" name="FixAllButton" class="fix-all-button" />
                </ui:VisualElement>
                <ui:VisualElement name="DrawersContainer" class="validation-list">
                    <!-- List Items will be added here -->
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
