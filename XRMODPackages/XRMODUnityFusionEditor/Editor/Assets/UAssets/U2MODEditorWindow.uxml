<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="script_process" style="flex-grow: 1; height: 81px;">
        <ui:VisualElement name="top_container" style="flex-grow: 0; flex-direction: row; height: 5%; flex-shrink: 1; width: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: center; align-items: center; align-self: auto; margin-top: 5px; flex-basis: initial; margin-right: 5px; margin-left: 5px;">
            <ui:TextField picking-mode="Ignore" value="Script locate" readonly="true" name="locate_path" style="height: auto; width: auto; margin-right: 0; margin-bottom: 0; margin-top: 0; margin-left: 0; align-items: auto; flex-shrink: 1;" />
            <ui:Button text="Browser" parse-escape-sequences="true" display-tooltip-when-elided="true" name="browser_btn" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="mid_container" style="flex-grow: 1; align-items: center; justify-content: center; align-self: auto; width: auto; height: 90%; margin-top: 0; margin-right: 5px; margin-left: 5px; padding-right: 2px; padding-left: 0;">
            <ui:ScrollView mode="VerticalAndHorizontal" style="flex-grow: 1; width: 100%; height: 100%;" />
        </ui:VisualElement>
        <ui:VisualElement name="footer_container" style="flex-grow: 1; flex-direction: row-reverse; height: 5%;">
            <ui:Button text="Process" parse-escape-sequences="true" display-tooltip-when-elided="true" name="next_step_btn" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-top: 0; margin-bottom: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
