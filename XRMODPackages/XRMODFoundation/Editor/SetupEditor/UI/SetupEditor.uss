.root {
    flex-grow: 1;
    padding: 10px;
    background-color: #383838;
}

.header-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 5px; 
}

.header-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: #d2d2d2;
}

.apply-button {
    height: 20px;
    width: 60px;
    background-color: #5bb974; /* Greenish apply button */
    color: #ffffff;
    -unity-font-style: bold;
    border-radius: 4px;
    padding: 0px;
    font-size: 11px;
    border-width: 0px;
}

.apply-button:hover {
    background-color: #6edc8b;
    color: #ffffff;
}

.fix-all-button {
    height: 20px;
    width: 60px;
    background-color: #4f4f4f;
    color: #e0e0e0;
    -unity-font-style: normal;
    border-radius: 4px;
    font-size: 11px;
    border-width: 1px;
    border-color: #2a2a2a;
    margin-right: 5px;
}

.fix-all-button:hover {
    background-color: #606060;
}

.section-container {
    background-color: #404040;
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 15px;
    border-width: 1px;
    border-color: #2a2a2a;
}

.section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #e0e0e0;
}

/* Validation List Styles */
.validation-list {
    flex-grow: 1;
    background-color: #282828;
    border-width: 1px;
    border-color: #232323;
    border-radius: 3px;
    margin-top: 5px;
}

.validation-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #303030;
    justify-content: space-between;
}

.validation-row:hover {
    background-color: #353535;
}

.validation-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.status-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    flex-shrink: 0;
}

.row-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
    color: #cccccc;
    white-space: normal; /* Allow text wrapping */
}

.fix-button {
    width: 70px;
    height: 22px;
}

/* Help Box Style (Embedded in row or below) */
.help-box {
    flex-direction: row;
    background-color: #3e3030;
    border-left-width: 3px;
    border-left-color: #ff5555;
    padding: 8px;
    margin-top: 0px; 
    margin-bottom: 5px;
    margin-left: 36px; /* Indent to align with text */
    margin-right: 10px;
}

.help-box-label {
    color: #ffaaaa;
    white-space: normal;
    font-size: 11px;
}

.platform-settings-container {
    margin-top: 5px;
    padding-left: 5px;
}
